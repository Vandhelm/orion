# Copier vers .env.local et remplir. Ne jamais committer .env.local.

# Connexion PostgreSQL
DATABASE_URL=postgres://user:password@localhost:5432/orion

# Secret de signature des cookies (32+ octets aléatoires) : openssl rand -base64 32
BETTER_AUTH_SECRET=

# URL publique du site (sert aussi à la vérification d'origine contre le CSRF)
BETTER_AUTH_URL=http://localhost:3000
